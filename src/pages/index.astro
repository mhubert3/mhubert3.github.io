---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Morgan Huberty</div>
    <div class="text-3xl py-3 font-bold">Computer Engineering Student</div>

    <div class="py-6 space-y-4">
      <p class="text-lg">
        Welcome to my personal website and digital portfolio! I'm a senior at
        Johns Hopkins University studying Computer Engineering (graduating May
        2027), focused on RTL design, design verification, and FPGA/ASIC
        engineering.
      </p>

      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 rounded-r-lg">
        <p class="text-lg">
          <span class="font-bold">Looking for:</span> full-time roles in RTL
          design, design verification, FPGA, and embedded engineering, starting
          after I graduate in May 2027. I'm open to relocating and to other
          opportunities for hands-on hardware experience.
        </p>
      </div>

      <div class="flex justify-start mb-4">
        <a
          href={`${import.meta.env.BASE_URL}Morgan%20Huberty%20Resume.pdf`}
          download
          class="inline-flex items-center px-6 py-3 text-lg font-bold bg-secondary text-primary-content rounded-lg hover:bg-primary-focus transition-colors duration-200 border-2 border-primary-content"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 mr-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Download Resume
        </a>
      </div>

      <div class="space-y-2">
        <h3 class="text-xl font-semibold">Education 🎓</h3>
        <p class="text-lg">Johns Hopkins University</p>
      </div>

      <div class="space-y-2">
        <h3 class="text-xl font-semibold">Academic Focus 📚</h3>
        <p class="text-lg">My major-relevant interests include:</p>
        <ul class="list-disc list-inside ml-4 text-lg">
          <li>RTL Design &amp; Design Verification</li>
          <li>Computer Architecture</li>
          <li>FPGA Prototyping &amp; Hardware Bring-Up</li>
          <li>ASIC Design Flow</li>
          <li>Hardware for AI Acceleration</li>
          <li>The Semiconductor Industry &amp; Supply Chain</li>
        </ul>
      </div>

      <div class="space-y-2">
        <h3 class="text-xl font-semibold">Personal Interests 🧐</h3>
        <p class="text-lg">
          Beyond my academic pursuits, I'm passionate about:
        </p>
        <ul class="list-disc list-inside ml-4 text-lg">
          <li>Health & Longevity</li>
          <li>History</li>
          <li>Resistance Training</li>
          <li>Philosophy</li>
          <li>Classic Novels</li>
          <li>Cooking</li>
          <li>Pop Culture</li>
          <li>Sailing</li>
          <li>Nature Walks</li>
        </ul>
      </div>

      <p class="text-lg">Thanks for stopping by! 🎉</p>
    </div>
  </div>

  <div>
    <div class="text-xl font-semibold text-center mb-8">
      Exploring the tight interplay between software and hardware.
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
    <!-- Left Column: Hardware Design -->
    <div>
      <h2 class="text-2xl font-bold mb-4">Hardware Design</h2>

      <div class="mb-6">
        <HorizontalCard
          title="ZipCPU Soft-Core Processor Build (Verilog)"
          img="/hardware.webp"
          desc="Working through the ZipCPU tutorial curriculum toward building a 32-bit pipelined RISC soft-core processor on an Artix-7 FPGA. Simulating each design with Verilator and C++ test drivers, then validating it on hardware."
          url="#"
          target="_self"
          badge="In Progress"
        />
      </div>

      <div class="mb-6">
        <HorizontalCard
          title="UART Transceiver (VHDL)"
          img="/uart-thumbnail.webp"
          desc="Designed a UART transmitter and receiver (8N1, 115,200 baud from a 12 MHz clock) with FSM control, a two-flop RX synchronizer, and mid-bit sampling. Verified with a self-checking testbench, then on hardware via loopback."
          url="/blog/synthesizable-uart-transceiver-in-vhdl"
        />
      </div>

      <div class="mb-6">
        <HorizontalCard
          title="I²C Master Controller (VHDL)"
          img="/i2c-thumbnail.webp"
          desc="Designed an FSM-based I²C master with repeated start, ACK/NACK, clock stretching, and open-drain SDA/SCL via Xilinx IOBUF primitives. Validated end-to-end on hardware with a PIC16F18326 slave."
          url="/blog/i2c-master-controller-in-vhdl"
        />
      </div>

    </div>

    <!-- Right Column: Software Systems -->
    <div>
      <h2 class="text-2xl font-bold mb-4">Software Systems</h2>

      <div class="mb-6">
        <HorizontalCard
          title="Key/Value Store (C++)"
          img="/software.webp"
          desc="Built a Redis-like in-memory K/V store with custom message serialization, multithreaded server (auto-commit & transactions with table-level locking), client utilities, and unit tests."
          url="https://github.com/mhubert3/KeyValue-Store"
        />
      </div>

      <div class="mb-6">
        <HorizontalCard
          title="Cache Simulator (C, C++)"
          img="/software.webp"
          desc="Simulated a configurable set-associative cache (sets, blocks, block size, LRU/FIFO replacement, write policies) that reports hit/miss counts and cycle totals from memory traces, used to compare associativity and policy trade-offs."
          url="https://github.com/mhubert3/Cache-Simulator"
        />
      </div>
    </div>
  </div>
</BaseLayout>
